<h1> productos </h1>

<%= Date.today %>

<% @products.each do |product|  %>
    <%= link_to product_path(product.id), class: 'product' do %>
        <%= image_tag product.photo, width: 100 if product.photo.attached? %>
        <h1><%= product.title  %></h1>
    <% end %>
    <h1>$<%= product.price %></h1>
<% end %>